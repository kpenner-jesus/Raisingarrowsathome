# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # server-only, bypasses RLS

# ── EmailJS (existing — applicant funnel) ────────────────────
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_GUEST_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ── Resend (admin-decision notifications) ────────────────────
# Get key from https://resend.com/api-keys
RESEND_API_KEY=
# Optional: from address. Defaults to "Raising Arrows <onboarding@resend.dev>".
# To send from your own domain, verify it in Resend dashboard first.
RESEND_FROM=Raising Arrows <onboarding@resend.dev>
# Where bi-monthly submission-window summaries go (Tierza). Defaults to
# register@raisingarrowsathome.com if unset.
SUMMARY_EMAIL_TO=info@raisingarrowsathome.com

# ── Anthropic (in-app AI chat assistant) ────────────────────
# Required to enable the admin + family AI chat. Without it, the chat UI is
# hidden and the chat routes return 503 (feature is silently dark). One shared
# platform key pays for all tenants. Get from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the chat model (defaults to claude-sonnet-4-6).
ANTHROPIC_MODEL=
# Optional: per-tenant daily message cap (defaults to 200).
AI_CHAT_DAILY_CAP=
# Required to let tenants store their OWN OpenRouter key (encrypts it at rest).
# Generate with: openssl rand -hex 32. Without it, tenants can't save a key and
# the assistant stays on the platform model.
AI_KEY_ENCRYPTION_SECRET=

# ── Attach from Google Drive (optional) ──────────────────────
# Adds a "From Google Drive" option to the admin chat's attach button. Leave
# blank and the button behaves exactly as before (opens the local file picker).
# All three are PUBLIC by design — a browser client ID and a referrer-restricted
# API key. There is NO Google secret: the access token lives only in the admin's
# browser and is never sent to our server. Scope is drive.file (per-file access
# to what the admin picks), so no Google verification review is required.
# Setup: docs/GOOGLE_DRIVE.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# Google Cloud project NUMBER (not the id). Required for drive.file picks.
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# ── Sheets webhook (existing optional) ───────────────────────
NEXT_PUBLIC_SHEETS_WEBHOOK_URL=

# ── Cron security ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-long-random-string
